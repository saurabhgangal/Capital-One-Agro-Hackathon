{
  "name": "kisan-ai-assistant",
  "version": "1.0.0",
  "description": "AI-powered agriculture assistant for Indian farmers with multilingual support, crop disease detection, and market insights",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "build": "echo 'No build step needed for production'",
    "build:client": "webpack --mode production --config webpack.config.js",
    "seed": "node src/scripts/seedData.js",
    "test": "jest",
    "deploy": "npm run build:client && npm start"
  },
  "keywords": [
    "agriculture",
    "AI",
    "farmers",
    "india",
    "crop-disease",
    "market-prices",
    "whatsapp",
    "multilingual"
  ],
  "author": "Capital One Agro Hackathon Team",
  "license": "MIT",
